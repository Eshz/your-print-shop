# Private writable directory outside public/; use persistent encrypted storage in production.
PRIVATE_STORAGE_PATH=.private
# Set to openai to offer optional artwork generation after drawing validation.
ARTWORK_PROVIDER=demo
OPENAI_API_KEY=
GENERATION_API_KEY=
PAYMENT_SECRET_KEY=
DATABASE_URL=
# Optional private vision classifier adapter (HTTPS). Never a NEXT_PUBLIC variable.
# Input/output contract is documented in README. Set only after provider privacy review.
DRAWING_VALIDATION_URL=
DRAWING_VALIDATION_KEY=

# Optional rights-cleared customer product/how-to video (public media URL or /videos/file.mp4).
# Do not use the reference site's video or an invented customer endorsement.
PRODUCT_VIDEO_URL=
# WebVTT captions matching the video's spoken language.
PRODUCT_VIDEO_CAPTIONS_URL=
PRODUCT_VIDEO_CAPTIONS_LANG=en
